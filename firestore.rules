rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Validate common fields
    function isString(field) {
      return field is string;
    }

    function isTimestampNowOrNull(field) {
      // Require server to set timestamps: client may omit them (null), server will set via Cloud Function or server SDK
      return field == null || field == request.time;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Create: user can create their own doc, but cannot set `role` (or may only set to 'user').
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.role == null || request.resource.data.role == 'user')
        && request.resource.data.keys().hasOnly(['uid', 'email', 'isAnonymous', 'createdAt', 'updatedAt', 'profile', 'role']);

      // Update: owner can update profile fields but cannot escalate role; admins can update everything.
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.role == resource.data.role
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.keys().hasOnly([
              'uid',
              'email',
              'isAnonymous',
              'createdAt',
              'updatedAt',
              'profile',
              'role'
            ]));

      // Delete allowed for owner or admin
      allow delete: if isOwner(userId) || isAdmin();

      // Ratings saved by the signed-in user, including anonymous accounts.
      match /ratings/{ratingId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'userId',
            'isAnonymous',
            'driverRating',
            'vehicleRating',
            'routeRating',
            'overallScore',
            'feedback',
            'createdAt'
          ])
          && isTimestampNowOrNull(request.resource.data.createdAt);
        allow update, delete: if isOwner(userId) || isAdmin();
      }

      // User-scoped trips.
      match /trips/{tripId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAny([
            'userId',
            'startedAt',
            'endedAt',
            'routeName',
            'metadata',
            'createdAt',
            'updatedAt'
          ])
          && isString(request.resource.data.userId)
          && isTimestampNowOrNull(request.resource.data.createdAt);
        allow update, delete: if isOwner(userId) || isAdmin();
      }

      // User-scoped incident reports.
      match /incidents/{incidentId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.reportedBy == request.auth.uid
          && request.resource.data.keys().hasAny([
            'reportedBy',
            'description',
            'location',
            'createdAt',
            'metadata'
          ])
          && isString(request.resource.data.reportedBy)
          && isTimestampNowOrNull(request.resource.data.createdAt);
        allow update: if isAdmin() || isOwner(userId);
        allow delete: if isAdmin();
      }
    }

    // Trips grouped by user UID: /trips/{userId}/items/{tripId}
    match /trips/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /items/{tripId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAny([
            'userId',
            'startedAt',
            'endedAt',
            'routeName',
            'metadata',
            'createdAt',
            'updatedAt'
          ])
          && isString(request.resource.data.userId)
          && isTimestampNowOrNull(request.resource.data.createdAt);
        allow update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // Incidents grouped by user UID: /incidents/{userId}/items/{incidentId}
    match /incidents/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;

      match /items/{incidentId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.reportedBy == request.auth.uid
          && request.resource.data.keys().hasAny([
            'reportedBy',
            'description',
            'location',
            'createdAt',
            'metadata'
          ])
          && isString(request.resource.data.reportedBy)
          && isTimestampNowOrNull(request.resource.data.createdAt);
        allow update: if isAdmin() || isOwner(userId);
        allow delete: if isAdmin();
      }
    }

    // Analytics - read for authenticated users, write only for admins
    match /analytics/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Settings - admin only
    match /settings/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Reports collection: allow authenticated users to create reports and
    // allow owners or admins to update/delete. Validate fields on create.
    match /reports/{reportId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        // require minimal fields and types
        && request.resource.data.keys().hasAll(['rating', 'createdAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        // optional numeric fields
        && (request.resource.data.lat == null || request.resource.data.lat is number)
        && (request.resource.data.lng == null || request.resource.data.lng is number)
        && (request.resource.data.trust == null || request.resource.data.trust is number)
        // owner field must match authenticated uid if present
        && (request.resource.data.reportedBy == null || request.resource.data.reportedBy == request.auth.uid)
        // createdAt may be set by client but should match request.time or be omitted
        && (request.resource.data.createdAt == request.time || request.resource.data.createdAt == null);

      // allow update/delete only by admin or owner
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.reportedBy == request.auth.uid);
    }

    // Passenger Trust Metrics
    match /passenger_trust_metrics/{passengerId} {
      // Allow reading trust metrics for any user (needed for map/community view)
      allow read: if isAuthenticated();
      // Allow the system/authenticated users to update trust metrics 
      // (in a real app, this should be done via Cloud Functions to prevent tampering)
      allow write: if isAuthenticated();
    }

    // Passenger Reports
    match /passenger_reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.passengerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.passengerId == request.auth.uid);
    }

    // Collection Group Queries for Community Trips
    // This allows `_db.collectionGroup('items')` to work for fetching community trips
    match /{path=**}/items/{itemId} {
      allow read: if isAuthenticated();
    }
  }
}
